[Unit]
Description=KDS - bloqueia suspensão do Orange Pi
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=kds-kiosk --why=KDS-kiosk-precisa-permanecer-acessivel --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
