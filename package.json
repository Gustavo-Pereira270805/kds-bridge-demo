{
  "name": "kds_bridge",
  "version": "2.0.0",
  "description": "KDS Bridge — Sistema de Comunicação Cozinha-Salão (Produção)",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:local": "node scripts/usar-banco-local.mjs && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npx copyfiles -f src/views/*.html src/views/favicon.jpg dist/views && npx copyfiles -f src/views/styles/* dist/views/styles && npx copyfiles -f src/views/scripts/*.js dist/views/scripts",
    "start": "node dist/server.js",
    "db:local:subir": "docker compose -f docker-compose.local.yml up -d",
    "db:local:descer": "docker compose -f docker-compose.local.yml down",
    "db:local:usar": "node scripts/usar-banco-local.mjs",
    "db:nuvem:usar": "node scripts/usar-banco-nuvem.mjs",
    "db:local:esquema": "node scripts/aplicar-esquema-local.mjs",
    "db:local:clonar": "node scripts/clonar-referencia-nuvem-local.mjs",
    "db:local:clonar:tudo": "node scripts/clonar-referencia-nuvem-local.mjs -- --com-operacionais",
    "db:local:zerar": "docker compose -f docker-compose.local.yml down -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@supabase/supabase-js": "^2.58.0",
    "brace-expansion": "^5.0.9",
    "dotenv": "^17.4.2",
    "engine.io": "^6.6.9",
    "fast-uri": "^4.1.2",
    "fastify": "^5.8.5",
    "find-my-way": "^9.8.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.16.0",
    "copyfiles": "^2.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ts-node-dev": {
      "rimraf": {
        "glob": {
          "minimatch": {
            "brace-expansion": "^1.1.18"
          }
        }
      }
    }
  }
}
