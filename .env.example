# KDS Bridge — variáveis de ambiente (copie para .env e preencha)
# .env NÃO deve ser versionado. Use este arquivo como modelo.

# Porta HTTP do servidor (o Caddy encaminha 443 -> app:3000)
PORT=3000

# Banco de dados PostgreSQL (Supabase cloud)
# IMPORTANTE: a conexão direta do Supabase (db.<ref>.supabase.co) é IPv6-only.
# O servidor/container PRECISA de conectividade IPv6 de saída (ex.: IPv6 na VCN da Oracle).
# Usuário: postgres | Porta: 5432
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU-REFERENCIA.supabase.co:5432/postgres

# Autenticação JWT via Supabase
SUPABASE_URL=https://SEU-REFERENCIA.supabase.co
SUPABASE_ANON_KEY=SUA-ANON-KEY

# (Opcional) Fixa o calendário de cardápio para datas determinísticas
REFERENCE_DATE=2025-01-01

# (Opcional) Origem adicional permitida no CORS HTTP
RETOOL_URL=

# (Opcional) Apenas para redes com proxy TLS de inspeção — nunca por padrão
# DB_SSL_REJECT_UNAUTHORIZED=false

NODE_ENV=production