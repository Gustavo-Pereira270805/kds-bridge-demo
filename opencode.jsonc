{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "higgsfield": {
      "type": "url",
      "url": "https://mcp.higgsfield.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${HIGGSFIELD_API_KEY}"
      },
      "enabled": false
    }
  }
}
