# Caddyfile — proxy reverso com TLS automático (Let's Encrypt)
# O domínio aponta para o IP público da instância (DuckDNS ou domínio próprio).
# O HTTPS (HTTP-01) exige as portas 80 e 443 liberadas no security list da Oracle.

{$DOMAIN} {
    handle /health {
        reverse_proxy app:3000
    }
    handle /ready {
        reverse_proxy app:3000
    }
    handle {
        reverse_proxy app:3000
    }
    encode gzip
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# Quiosques via Tailscale: HTTP puro (o transporte já é criptografado pelo
# WireGuard) para que o Caddy veja o IP 100.x do Pi no X-Forwarded-For e o
# bypass de login funcione. NÃO apontar os Pis para o domínio público:
# por ele o Pi chega com o IP de saída da internet e cai no /login.
http://100.81.149.114 {
    reverse_proxy app:3000
}

:80 {
    redir https://{host}{uri} permanent
}